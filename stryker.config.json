{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "mutate": [
    "src/**/*.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  },
  "timeoutMS": 120000,
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}

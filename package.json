{
  "name": "schema-fit",
  "version": "0.1.1",
  "description": "Rewrite a JSON Schema so a specific LLM provider accepts it, without ever widening what it allows.",
  "keywords": [
    "json-schema",
    "llm",
    "tool-use",
    "function-calling",
    "openai",
    "anthropic",
    "gemini",
    "structured-outputs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamerkalla/schema-fit.git"
  },
  "homepage": "https://github.com/tamerkalla/schema-fit#readme",
  "bugs": {
    "url": "https://github.com/tamerkalla/schema-fit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke.cjs",
    "mutation": "stryker run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.23.2",
    "json-schema-faker": "^0.5.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
